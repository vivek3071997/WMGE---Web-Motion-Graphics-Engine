{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:motion-forge:project:v1",
  "title": "Motion Forge project v1",
  "description": "Run scripts/validate.cjs as well: references, cycles, unique IDs, time order, colour track types and combined asset limits require semantic checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "maxLength": 160
    },
    "width": {
      "type": "number",
      "minimum": 256,
      "maximum": 4096
    },
    "height": {
      "type": "number",
      "minimum": 256,
      "maximum": 4096
    },
    "fps": {
      "type": "number",
      "minimum": 1,
      "maximum": 60
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "assets": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "required": [
    "version",
    "name",
    "width",
    "height",
    "fps",
    "theme",
    "assets",
    "scenes"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
    },
    "colour": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{3}|#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8}|\\$(background|surface|accent|secondary|text|muted|line)|none)$"
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "line": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "background",
        "surface",
        "accent",
        "secondary",
        "text",
        "muted",
        "line"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "src": {
          "type": "string",
          "maxLength": 14000000,
          "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$"
        },
        "credit": {
          "type": "string",
          "maxLength": 1000
        },
        "source": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "name",
        "src"
      ]
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "solid",
            "linear",
            "radial",
            "transparent"
          ]
        },
        "color": {
          "$ref": "#/$defs/colour"
        },
        "color2": {
          "$ref": "#/$defs/colour"
        },
        "angle": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "grid": {
          "type": "boolean"
        },
        "gridSize": {
          "type": "number",
          "minimum": 10,
          "maximum": 400
        },
        "gridOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "type"
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "property": {
          "enum": [
            "x",
            "y",
            "width",
            "height",
            "rotation",
            "scale",
            "opacity",
            "fontSize",
            "strokeWidth",
            "radius",
            "progress",
            "fill",
            "stroke"
          ]
        },
        "loop": {
          "type": "boolean"
        },
        "keyframes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "time": {
                "type": "number",
                "minimum": 0,
                "maximum": 600
              },
              "value": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": -1000000,
                    "maximum": 1000000
                  },
                  {
                    "$ref": "#/$defs/colour"
                  }
                ]
              },
              "easing": {
                "enum": [
                  "linear",
                  "easeIn",
                  "easeOut",
                  "easeInOut",
                  "backOut",
                  "step"
                ]
              }
            },
            "required": [
              "time",
              "value"
            ]
          }
        }
      },
      "required": [
        "property",
        "keyframes"
      ]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
