        "lineHeight": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "fontFamily": {
          "enum": [
            "sans",
            "mono",
            "serif"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "text"
      ]
    },
