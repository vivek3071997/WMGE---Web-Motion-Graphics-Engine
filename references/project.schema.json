        },
        "stroke": {
          "$ref": "#/$defs/colour"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 20000
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "end": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "enter": {
          "enum": [
            "none",
            "fade",
            "rise",
            "slide",
            "scale",
            "draw"
          ]
        },
        "enterDuration": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "exitDuration": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "parentId": {
          "$ref": "#/$defs/id"
        },
        "hidden": {
          "type": "boolean"
        },
        "tracks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/track"
