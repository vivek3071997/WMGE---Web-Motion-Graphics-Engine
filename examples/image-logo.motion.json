{
  "version": 1,
  "name": "Custom image demonstration",
  "width": 1600,
  "height": 900,
  "fps": 30,
  "theme": {
    "background": "#0b1020",
    "surface": "#182237",
    "accent": "#8d9bff",
    "secondary": "#56e0cf",
    "text": "#f4f6ff",
    "muted": "#91a0b8",
    "line": "#34445e"
  },
  "assets": {
    "forgeLogo": {
      "name": "Motion Forge demonstration mark",
      "src": "data:image/png;base64,",
      "credit": "Motion Forge contributors; MIT license"
    }
  },
  "scenes": [
    {
      "id": "brand",
      "name": "Custom logo",
      "duration": 10,
      "background": {
        "type": "radial",
        "color": "$background",
        "color2": "$surface",
        "grid": true,
        "gridSize": 60,
        "gridOpacity": 0.07
      },
      "layers": [
        {
          "id": "eyebrow",
          "type": "text",
          "name": "eyebrow",
          "x": 100,
          "y": 65,
          "width": 1300,
          "height": 23.400000000000002,
          "enter": "fade",
          "enterDuration": 0.75,
          "text": "06 / VISUAL EVIDENCE",
          "fontSize": 18,
          "fill": "$accent",
          "fontFamily": "mono"
        },
        {
          "id": "title",
          "type": "text",
          "name": "title",
          "x": 96,
          "y": 112,
          "width": 1300,
          "height": 88.4,
          "enter": "rise",
          "enterDuration": 0.75,
          "text": "A place for your brand.",
          "fontSize": 68,
          "fill": "$text",
          "fontWeight": 700,
          "start": 0.1
        },
        {
          "id": "subtitle",
          "type": "text",
          "name": "subtitle",
          "x": 100,
          "y": 207,
          "width": 1300,
          "height": 32.5,
          "enter": "rise",
          "enterDuration": 0.75,
          "text": "Original demo logo, embedded in this portable project.",
          "fontSize": 25,
          "fill": "$muted",
          "start": 0.2
        },
        {
          "id": "evidence-card",
          "type": "rect",
          "name": "evidence card",
          "x": 100,
          "y": 315,
          "width": 920,
          "height": 450,
          "enter": "rise",
          "enterDuration": 0.75,
          "fill": "$surface",
          "stroke": "$line",
          "radius": 24,
          "start": 0.3
        },
        {
          "id": "image-note",
          "type": "text",
          "name": "image note",
          "x": 195,
          "y": 690,
          "width": 800,
          "height": 23.400000000000002,
          "enter": "rise",
          "enterDuration": 0.75,
          "text": "ORIGINAL DEMO ASSET · MIT LICENSE",
          "fontSize": 18,
          "fill": "$muted",
          "fontFamily": "mono",
          "start": 1
        },
        {
          "id": "evidence-label",
          "type": "text",
          "name": "evidence label",
          "x": 1090,
          "y": 360,
          "width": 400,
          "height": 26,
          "enter": "rise",
          "enterDuration": 0.75,
          "text": "YOUR IMAGE / YOUR STYLE",
          "fontSize": 20,
          "fill": "$secondary",
          "start": 0.6
        },
        {
          "id": "evidence-title",
          "type": "text",
          "name": "evidence title",
          "x": 1090,
          "y": 415,
          "width": 410,
          "height": 55.9,
          "enter": "rise",
          "enterDuration": 0.75,
          "text": "Edit the scene.\nKeep your assets.",
          "fontSize": 43,
          "fill": "$text",
          "fontWeight": 700,
          "start": 0.9
        },
        {
          "id": "evidence-caption",
          "type": "text",
          "name": "evidence caption",
          "x": 1090,
          "y": 585,
          "width": 420,
          "height": 31.200000000000003,
          "enter": "rise",
          "enterDuration": 0.75,
          "text": "Transparent PNG / WebP\nEmbedded in the project\nReady for any LLM workflow",
          "fontSize": 24,
          "fill": "$muted",
          "start": 1.2
        },
        {
          "id": "brand-mark",
          "type": "image",
          "name": "Original logo asset",
          "asset": "forgeLogo",
          "x": 380,
          "y": 350,
          "width": 360,
          "height": 300,
          "radius": 0,
          "fit": "contain",
          "enter": "scale",
          "start": 0.5,
          "enterDuration": 1
        }
      ]
    }
  ]
}
