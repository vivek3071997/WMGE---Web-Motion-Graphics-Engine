{
  "version": 1,
  "name": "Systems in motion",
  "width": 1600,
  "height": 900,
  "fps": 30,
  "theme": {
    "background": "#0b1020",
    "surface": "#182237",
    "accent": "#8d9bff",
    "secondary": "#56e0cf",
    "text": "#f4f6ff",
    "muted": "#91a0b8",
    "line": "#34445e"
  },
  "assets": {},
  "scenes": [
    {
      "id": "data",
      "name": "Data and comparison",
      "duration": 10,
      "background": {
        "type": "radial",
        "color": "$background",
        "color2": "$surface",
        "grid": true,
        "gridSize": 60,
        "gridOpacity": 0.07
      },
      "layers": [
        {
          "id": "eyebrow",
          "type": "text",
          "name": "eyebrow",
          "x": 100,
          "y": 65,
          "width": 1300,
          "height": 23.400000000000002,
          "enter": "fade",
          "enterDuration": 0.75,
          "text": "03 / DATA STORY",
          "fontSize": 18,
          "fill": "$accent",
          "fontFamily": "mono"
        },
        {
          "id": "title",
          "type": "text",
          "name": "title",
          "x": 96,
          "y": 112,
          "width": 1300,
          "height": 88.4,
          "enter": "rise",
          "enterDuration": 0.75,
          "text": "Make the difference visible.",
          "fontSize": 68,
          "fill": "$text",
          "fontWeight": 700,
          "start": 0.1
        },
        {
          "id": "subtitle",
          "type": "text",
          "name": "subtitle",
          "x": 100,
          "y": 207,
          "width": 1300,
          "height": 32.5,
          "enter": "rise",
          "enterDuration": 0.75,
          "text": "Illustrative values only. Label your sources before publishing.",
          "fontSize": 25,
          "fill": "$muted",
          "start": 0.2
        },
        {
          "id": "chart-card",
          "type": "rect",
          "name": "chart card",
          "x": 100,
          "y": 315,
          "width": 900,
          "height": 450,
          "enter": "rise",
          "enterDuration": 0.75,
          "fill": "$surface",
          "stroke": "$line",
          "radius": 24,
          "start": 0.2
        },
        {
          "id": "bar-chart",
          "type": "chart",
          "name": "bar chart",
          "x": 140,
          "y": 365,
          "width": 820,
          "height": 350,
          "enter": "scale",
          "enterDuration": 2,
          "values": [
            32,
            48,
            67,
            86
          ],
          "labels": [
            "BASELINE",
            "PASS 01",
            "PASS 02",
            "PASS 03"
          ],
          "colors": [
            "$line",
            "$accent",
            "$accent",
            "$secondary"
          ],
          "maxValue": 100,
          "fill": "$accent",
          "fontSize": 21,
          "start": 0.8
        },
        {
          "id": "metric-label",
          "type": "text",
          "name": "metric label",
          "x": 1080,
          "y": 345,
          "width": 420,
          "height": 26,
          "enter": "rise",
          "enterDuration": 0.75,
          "text": "EXAMPLE IMPROVEMENT",
          "fontSize": 20,
          "fill": "$muted",
          "start": 1
        },
        {
          "id": "metric",
          "type": "counter",
          "name": "metric",
          "x": 1070,
          "y": 400,
          "width": 420,
          "height": 160,
          "enter": "rise",
          "enterDuration": 2.3,
          "valueFrom": 0,
          "valueTo": 2.7,
          "decimals": 1,
          "suffix": "×",
          "fontSize": 144,
          "fontWeight": 700,
          "fill": "$secondary",
          "start": 1
        },
        {
          "id": "metric-caption",
          "type": "text",
          "name": "metric caption",
          "x": 1080,
          "y": 605,
          "width": 420,
          "height": 32.5,
          "enter": "rise",
          "enterDuration": 0.75,
          "text": "Replace these values\nwith measured results.",
          "fontSize": 25,
          "fill": "$muted",
          "start": 1.5
        },
        {
          "id": "source",
          "type": "text",
          "name": "source",
          "x": 100,
          "y": 805,
          "width": 1300,
          "height": 22.1,
          "enter": "rise",
          "enterDuration": 0.75,
          "text": "SOURCE: DEMONSTRATION DATA — NOT A PERFORMANCE CLAIM",
          "fontSize": 17,
          "fill": "$muted",
          "fontFamily": "mono"
        }
      ]
    }
  ]
}